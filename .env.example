# Server Port
PORT=8080

# Discord Bot Credentials
# Note: Leave empty or 'demo' to run in full interactive Demo mode with mock servers!
DISCORD_BOT_TOKEN=demo

# Discord OAuth2 Application Credentials (For Web Dashboard Login)
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

# JWT and Persistence
JWT_SECRET=super-secret-jwt-key-titan-bot
DATA_PATH=./data.json
